# Copia este archivo a .env.local (local) o cárgalo en Vercel → Settings → Environment Variables.

# ID de tu contenedor de Google Tag Manager (formato GTM-XXXXXXX).
# Sin él, el sitio funciona igual y los eventos se encolan en window.dataLayer sin enviarse a ningún lado.
NEXT_PUBLIC_GTM_ID=

# URL final del sitio (sitemap, robots, imagen Open Graph y datos estructurados).
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
